from pyspark.sql import SparkSession
from pyspark.sql.functions import col, trim, year, sum as _sum, avg, stddev
from pyspark.sql.functions import broadcast

spark = SparkSession.builder.appName("DatabricksAssignment").getOrCreate()

# Load Part 1: CSV file
time_series_df = (
    spark.read.option("header", True).csv("s3://your-bucket/bls-data/pr.data.0.Current")
)

# Load Part 2: JSON file
population_df = (
    spark.read.option("multiline", True).json("s3://your-bucket/datausa-population/*.json")
)

# Inspect schemas
time_series_df.printSchema()
population_df.printSchema()

# Flatten JSON structure
population_df = population_df.selectExpr("data as records").selectExpr("inline(records)")
population_df.show(5)

# Mean & Standard Deviation of Population (2013–2018)
pop_stats_df = (
    population_df
    .filter((col("Year") >= 2013) & (col("Year") <= 2018))
    .agg(
        avg("Population").alias("mean_population"),
        stddev("Population").alias("stddev_population")
    )
)

pop_stats_df.show()

#Best Year per Series ID (max sum of quarterly values)
# Clean values (convert to numeric)
time_series_df = time_series_df.withColumn("value", col("value").cast("double"))
time_series_df = time_series_df.withColumn("year", col("year").cast("int"))

best_year_df = (
    time_series_df
    .groupBy("series_id", "year")
    .agg(_sum("value").alias("yearly_sum"))
    .withColumn("rank", 
        row_number().over(
            Window.partitionBy("series_id").orderBy(col("yearly_sum").desc())
        )
    )
    .filter(col("rank") == 1)
    .select("series_id", "year", "yearly_sum")
)

best_year_df.show()

#Join Population + Time-Series (for specific series/period)
filtered_df = (
    time_series_df
    .filter((col("series_id") == "PRS30006032") & (col("period") == "Q01"))
    .join(
        broadcast(population_df),
        time_series_df.year == population_df.Year,
        "left"
    )
    .select(
        "series_id",
        time_series_df.year,
        "period",
        "value",
        "Population"
    )
)

filtered_df.show()

